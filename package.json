{
  "name": "spincrete",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.worker.json --noEmit && tsc -p tsconfig.pages.json --noEmit",
    "dev:worker": "wrangler dev --config wrangler.worker.toml",
    "deploy:pages": "npm run build && wrangler pages deploy dist",
    "deploy:worker": "wrangler deploy --config wrangler.worker.toml",
    "seed:db": "wrangler d1 execute spincrete-db --file=worker/d1/seed.sql --local"
  },
  "dependencies": {
    "framer-motion": "^12.23.12",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "zustand": "^5.0.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250522.0",
    "@tailwindcss/postcss": "^4.1.11",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^5.0.0",
    "autoprefixer": "^10.4.21",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.11",
    "typescript": "^5.9.2",
    "vite": "^7.1.5",
    "wrangler": "^4.31.0"
  }
}
